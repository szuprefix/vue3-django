{
  "name": "vue3-django",
  "version": "0.1.7",
  "description": "DRF metadata-driven Vue 3 framework",
  "keywords": [
    "vue3",
    "element-plus",
    "django",
    "drf",
    "schema",
    "metadata-driven"
  ],
  "type": "module",
  "main": "./dist/vue3-django.js",
  "exports": {
    ".": "./dist/vue3-django.js",
    "./style.css": "./dist/vue3-django.css",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "docs"
  ],
  "scripts": {
    "dev": "vite --config examples/dashboard/vite.config.js",
    "dev:dashboard": "vite --config examples/dashboard/vite.config.js",
    "dev:mobile": "vite --config examples/mobile/vite.config.js",
    "build": "vite build",
    "build:demo": "npm run build:dashboard",
    "build:dashboard": "vite build --config examples/dashboard/vite.config.js",
    "build:mobile": "vite build --config examples/mobile/vite.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "element-plus": "^2.11.0",
    "vant": "^4.9.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "async-validator": "^4.2.5",
    "axios": "^1.12.0",
    "dompurify": "^3.4.16",
    "exceljs": "^4.4.0",
    "qs": "^6.14.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "2.4.6",
    "element-plus": "^2.11.0",
    "font-awesome": "^4.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "vant": "^4.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "ISC"
}
